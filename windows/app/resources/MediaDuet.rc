#include <winres.h>
#include "resource.h"

IDI_APP      ICON "app.ico"
IDI_TRAY_ON  ICON "tray_on.ico"
IDI_TRAY_OFF ICON "tray_off.ico"

1 RT_MANIFEST "MediaDuet.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,6,0,0
 PRODUCTVERSION 1,6,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "tianli"
            VALUE "FileDescription", "MediaDuet"
            VALUE "FileVersion", "1.6.0"
            VALUE "InternalName", "MediaDuet"
            VALUE "LegalCopyright", "Copyright (c) 2026 tianli. MIT License."
            VALUE "OriginalFilename", "MediaDuet.exe"
            VALUE "ProductName", "MediaDuet"
            VALUE "ProductVersion", "1.6.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
