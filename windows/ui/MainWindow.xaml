<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaDuetUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaDuetUI">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Artwork tint over the Mica backdrop: a dithered bitmap rendered in code (Ambient.h), no
             8-bit gradient brush (those show colour bands across a large window). -->
        <Grid x:Name="TintLayer" Grid.RowSpan="2" IsHitTestVisible="False" />

        <!-- Custom title bar: back button (settings) + drag region -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionInsetColumn" Width="138" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" x:Uid="BackButton" Style="{StaticResource NavigationBackButtonNormalStyle}"
                    Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <Grid x:Name="DragRegion" Grid.Column="1" Background="Transparent" Padding="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="TitleIcon" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
                <Border x:Name="ConnectionPill" Grid.Column="2" Margin="0,0,8,0" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Style="{StaticResource PillStyle}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{ThemeResource StatusIdleBrush}" />
                        <FontIcon x:Name="ConnectionIcon" FontSize="13" Glyph="&#xE702;" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConnectionText" Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" MaxWidth="320" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Player page ===== -->
        <Grid x:Name="PlayerPage" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- Player -->
        <Grid x:Name="PlayerGrid" Grid.Row="1" Padding="20,0,24,0" Visibility="Collapsed" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CardColumn" Width="*" />
                <ColumnDefinition x:Name="LyricsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- The card never clips: it scrolls when the window is too short (after optional rows collapse). -->
            <ScrollViewer x:Name="CardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Disabled" ZoomMode="Disabled">
            <StackPanel x:Name="Card" Width="340" Margin="0,8,0,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid x:Name="ArtFrame" Width="300" Height="300" HorizontalAlignment="Center" CornerRadius="14"
                      Translation="0,0,32">
                    <Grid.Shadow>
                        <ThemeShadow />
                    </Grid.Shadow>
                    <Border x:Name="ArtPlaceholder" CornerRadius="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="{ThemeResource ArtPlaceholderStart}" />
                                <GradientStop Offset="1" Color="{ThemeResource ArtPlaceholderEnd}" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon x:Name="ArtPlaceholderIcon" FontSize="72" Glyph="&#xE8D6;">
                            <FontIcon.Foreground>
                                <SolidColorBrush Color="{ThemeResource ArtPlaceholderGlyph}" />
                            </FontIcon.Foreground>
                        </FontIcon>
                    </Border>
                    <Border x:Name="ArtImageBorder" CornerRadius="14" Opacity="0">
                        <Border.Background>
                            <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>

                <TextBlock x:Name="TitleLabel" Margin="0,24,0,0" FontSize="22" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxLines="2" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
                <TextBlock x:Name="ArtistLabel" Margin="0,4,0,0" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="AlbumLabel" Margin="0,2,0,0" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           TextAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Border Style="{StaticResource PillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="DeviceIcon" FontSize="12" Glyph="&#xE977;" />
                            <TextBlock x:Name="DeviceLabel" Style="{StaticResource CaptionTextBlockStyle}" MaxWidth="112"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8D6;" />
                            <TextBlock x:Name="AppLabel" Style="{StaticResource CaptionTextBlockStyle}" MaxWidth="112"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Margin="0,8,0,0" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Slider x:Name="ProgressSlider" x:Uid="ProgressSlider" Margin="0,10,0,0" Minimum="0" Maximum="1" StepFrequency="1000"
                        IsThumbToolTipEnabled="False" />
                <Grid Margin="2,-6,2,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedLabel" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--:--" />
                    <TextBlock x:Name="DurationLabel" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="--:--" />
                </Grid>

                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="18">
                    <Button x:Name="PrevButton" x:Uid="PrevButton" Style="{StaticResource IconButtonStyle}" Width="48" Height="48" CornerRadius="24">
                        <FontIcon FontSize="20" Glyph="&#xE892;" />
                    </Button>
                    <Button x:Name="PlayPauseButton" x:Uid="PlayPauseButton" Style="{StaticResource AccentButtonStyle}"
                            Width="60" Height="60" CornerRadius="30" Padding="0">
                        <FontIcon x:Name="PlayPauseIcon" FontSize="24" Glyph="&#xE768;" />
                    </Button>
                    <Button x:Name="NextButton" x:Uid="NextButton" Style="{StaticResource IconButtonStyle}" Width="48" Height="48" CornerRadius="24">
                        <FontIcon FontSize="20" Glyph="&#xE893;" />
                    </Button>
                </StackPanel>

                <!-- The player's own buttons (phone apps: like / favourite, ...) and its play queue -->
                <StackPanel x:Name="ExtrasRow" Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                            Spacing="2" Visibility="Collapsed">
                    <StackPanel x:Name="CustomActionsPanel" Orientation="Horizontal" Spacing="2" />
                    <Button x:Name="QueueButton" x:Uid="QueueButton" Style="{StaticResource IconButtonStyle}" Visibility="Collapsed">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        <Button.Flyout>
                            <Flyout x:Name="QueueFlyout" Placement="Top">
                                <Grid Width="360" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Uid="QueueTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="QueueSubtitle" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ListView x:Name="QueueList" Grid.Row="1" MaxHeight="440" SelectionMode="None" IsItemClickEnabled="True"
                                              Margin="-12,0,-12,-8" />
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- Volume of the device that plays the focused session -->
                <StackPanel x:Name="InlineVolume" Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                            Spacing="6" Visibility="Collapsed">
                    <Button x:Name="InlineMuteButton" x:Uid="MuteButton" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" CornerRadius="16">
                        <FontIcon x:Name="InlineMuteIcon" FontSize="14" Glyph="&#xE995;" />
                    </Button>
                    <Slider x:Name="InlineVolumeSlider" x:Uid="InlineVolumeSlider" Width="160" Minimum="0" Maximum="100"
                            StepFrequency="1" SmallChange="2" LargeChange="10" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                    <TextBlock x:Name="InlineVolumeText" Width="36" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <!-- The phone refused a volume change (Android background restriction): non-blocking hint. -->
                <Grid x:Name="InlineVolumeHint" Margin="8,4,8,0" ColumnSpacing="6" HorizontalAlignment="Center" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon FontSize="12" Glyph="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    <TextBlock x:Name="InlineVolumeHintText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                               MaxLines="3" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <DropDownButton x:Name="SourceButton" x:Uid="SourceButton" Margin="0,12,0,4" HorizontalAlignment="Center"
                                MaxWidth="340" Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="16">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="13" Glyph="&#xE8AB;" VerticalAlignment="Center" />
                        <TextBlock x:Name="SourceButtonText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SourceFlyout" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            </ScrollViewer>

            <!-- Synced lyrics -->
            <!-- Comfortable reading width; a wider column centres it (text stays left-aligned). -->
            <Grid x:Name="LyricsHost" Grid.Column="1" Margin="24,0,0,0" MaxWidth="740" HorizontalAlignment="Stretch" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Lines are positioned by LyricsView (per-line composition translations), not by a
                     ScrollViewer: the viewport clips, wheel / touch scrolling is handled in code. -->
                <Grid x:Name="LyricsViewport" x:Uid="LyricsScroller" Background="Transparent">
                    <Canvas x:Name="LyricsCanvas">
                        <StackPanel x:Name="LyricsPanel" Spacing="14" />
                    </Canvas>
                    <Button x:Name="LyricsFollowButton" x:Uid="LyricsFollowButton" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,10" Padding="14,5,14,6" CornerRadius="16" FontSize="12" Visibility="Collapsed" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,4,4,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Quick translation toggle (only when the lyrics carry translations) -->
                    <ToggleButton x:Name="TranslationButton" x:Uid="TranslationButton" Visibility="Collapsed" VerticalAlignment="Center"
                                  Padding="10,2,10,3" MinHeight="0" MinWidth="0" FontSize="12" CornerRadius="12" />
                    <!-- Lyrics timing: per-app offset (lyrics.offset); shortcuts [ and ] -->
                    <Button x:Name="LyricsOffsetButton" x:Uid="LyricsOffsetButton" Grid.Column="1" Visibility="Collapsed" VerticalAlignment="Center"
                            Padding="10,2,10,3" MinHeight="0" MinWidth="0" CornerRadius="12" Background="Transparent" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE916;" VerticalAlignment="Center" />
                            <TextBlock x:Name="LyricsOffsetButtonText" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout x:Name="LyricsOffsetFlyout" Placement="Top">
                                <StackPanel Width="280" Spacing="10">
                                    <TextBlock x:Uid="LyricsOffsetTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="LyricsEarlierButton" x:Uid="LyricsEarlierButton" MinWidth="76" />
                                        <TextBlock x:Name="LyricsOffsetValue" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="20" FontWeight="SemiBold" />
                                        <Button x:Name="LyricsLaterButton" x:Uid="LyricsLaterButton" Grid.Column="2" MinWidth="76" />
                                    </Grid>
                                    <TextBlock x:Name="LyricsOffsetDetail" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button x:Name="LyricsOffsetResetButton" x:Uid="LyricsOffsetResetButton" HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock x:Name="LyricsSourceLabel" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Nothing playing -->
        <StackPanel x:Name="EmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="420" Spacing="10" Visibility="Collapsed">
            <FontIcon FontSize="56" Glyph="&#xE8D6;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Uid="EmptyTitle" Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="EmptyPairButton" x:Uid="EmptyPairButton" Margin="0,8,0,0" HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed" />
            <!-- No phone yet: the PC-only mode is one click away (Settings > General > Work mode). -->
            <HyperlinkButton x:Name="EmptyStandaloneButton" x:Uid="EmptyStandaloneButton" HorizontalAlignment="Center"
                             Visibility="Collapsed" />
        </StackPanel>

        <!-- First run (no phone paired yet, no work mode chosen): how MediaDuet will be used. Asked
             once, inside the window (no dialog); changeable in Settings > General. -->
        <ScrollViewer x:Name="WelcomePanel" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                      HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Padding="24,12,24,32" Spacing="6">
                <Image x:Name="WelcomeIcon" Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock x:Uid="WelcomeTitle" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="WelcomeSubtitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Margin="0,22,0,0" ColumnSpacing="14" RowSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="WelcomeLinkedButton" Style="{StaticResource WelcomeCardStyle}">
                        <StackPanel Spacing="6">
                            <FontIcon FontSize="26" Glyph="&#xE8EA;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Uid="WelcomeLinkedTitle" Margin="0,6,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WelcomeLinkedDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="WelcomeStandaloneButton" Grid.Column="1" Style="{StaticResource WelcomeCardStyle}">
                        <StackPanel Spacing="6">
                            <FontIcon FontSize="26" Glyph="&#xE7F4;" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Uid="WelcomeStandaloneTitle" Margin="0,6,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="WelcomeStandaloneDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Uid="WelcomeFootnote" Margin="0,14,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Host not running / connecting -->
        <StackPanel x:Name="HostPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="440" Spacing="10" Visibility="Collapsed">
            <ProgressRing x:Name="HostProgress" Width="40" Height="40" IsActive="False" />
            <FontIcon x:Name="HostIcon" FontSize="56" Glyph="&#xE7BA;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock x:Name="HostTitle" Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock x:Name="HostText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button x:Name="StartHostButton" x:Uid="StartHostButton" Margin="0,8,0,0" HorizontalAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!-- Phone and PC on different major/minor versions (host: md::version), dismissible per pair.
             Its own Auto row: while open it moves the player down instead of covering it. -->
        <InfoBar x:Name="VersionBar" Grid.Row="0" HorizontalAlignment="Center" MaxWidth="760"
                 Margin="24,2,24,10" IsOpen="False" Severity="Warning" IsClosable="True" />

        <!-- Bottom bar -->
        <Grid x:Name="BottomBar" Grid.Row="2" Padding="24,6,16,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Grid (not a horizontal StackPanel) so a long status trims instead of overflowing both edges. -->
            <Grid x:Name="PolicyPanel" ColumnSpacing="8" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon FontSize="13" Glyph="&#xEA18;" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="PolicyText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
            <InfoBar x:Name="ErrorBar" Grid.ColumnSpan="2" Margin="0,0,180,0" IsOpen="False" Severity="Error" IsClosable="True" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button x:Name="VolumeButton" x:Uid="VolumeButton" Style="{StaticResource IconButtonStyle}">
                    <FontIcon x:Name="VolumeButtonIcon" FontSize="16" Glyph="&#xE995;" />
                    <Button.Flyout>
                        <Flyout x:Name="VolumeFlyout" Placement="TopEdgeAlignedRight">
                            <StackPanel Width="300" Spacing="14">
                                <TextBlock x:Uid="VolumeFlyoutTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <StackPanel x:Name="LocalVolumeRow" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="13" Glyph="&#xE977;" />
                                        <TextBlock x:Uid="VolumeThisPc" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="LocalMuteButton" x:Uid="MuteButton" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" CornerRadius="16">
                                            <FontIcon x:Name="LocalMuteIcon" FontSize="14" Glyph="&#xE995;" />
                                        </Button>
                                        <Slider x:Name="LocalVolumeSlider" x:Uid="LocalVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                                StepFrequency="1" SmallChange="2" LargeChange="10" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                                        <TextBlock x:Name="LocalVolumeText" Grid.Column="2" Width="36" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="AppVolumeRow" Spacing="2" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="13" Glyph="&#xE8D6;" />
                                        <TextBlock x:Name="AppVolumeName" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="AppMuteButton" x:Uid="MuteButton" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" CornerRadius="16">
                                            <FontIcon x:Name="AppMuteIcon" FontSize="14" Glyph="&#xE995;" />
                                        </Button>
                                        <Slider x:Name="AppVolumeSlider" x:Uid="AppVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                                StepFrequency="1" SmallChange="2" LargeChange="10" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                                        <TextBlock x:Name="AppVolumeText" Grid.Column="2" Width="36" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="RemoteVolumeRow" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="13" Glyph="&#xE8EA;" />
                                        <TextBlock x:Name="RemoteVolumeName" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="RemoteMuteButton" x:Uid="MuteButton" Style="{StaticResource IconButtonStyle}" Width="32" Height="32" CornerRadius="16">
                                            <FontIcon x:Name="RemoteMuteIcon" FontSize="14" Glyph="&#xE995;" />
                                        </Button>
                                        <Slider x:Name="RemoteVolumeSlider" x:Uid="RemoteVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100"
                                                StepFrequency="1" SmallChange="2" LargeChange="10" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RemoteVolumeText" Grid.Column="2" Width="36" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                    <Grid x:Name="RemoteVolumeHint" Margin="0,4,0,0" ColumnSpacing="6" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="12" Glyph="&#xE7BA;" VerticalAlignment="Top" Margin="0,2,0,0"
                                                  Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                        <TextBlock x:Name="RemoteVolumeHintText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="VolumeUnavailableText" x:Uid="VolumeUnavailable" Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!-- Quick switch: this PC plays the phone's Bluetooth audio (A2DP sink); only when the
                     phone is a paired Bluetooth audio source of this PC. -->
                <ToggleButton x:Name="A2dpQuickToggle" x:Uid="A2dpQuickToggle" Style="{StaticResource IconToggleButtonStyle}"
                              Visibility="Collapsed">
                    <FontIcon FontSize="16" Glyph="&#xE702;" />
                </ToggleButton>
                <ToggleButton x:Name="OverlayToggle" x:Uid="OverlayToggle" Style="{StaticResource IconToggleButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE7F0;" />
                </ToggleButton>
                <Button x:Name="CompactButton" x:Uid="CompactButton" Style="{StaticResource IconButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE73F;" />
                </Button>
                <Button x:Name="SettingsButton" x:Uid="SettingsButton" Style="{StaticResource IconButtonStyle}">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>
        </Grid>

        <!-- ===== Settings page: SettingsPage, created in code on first use (row 1) ===== -->
    </Grid>
</Window>
