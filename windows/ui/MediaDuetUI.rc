#include <winres.h>
#include "resource.h"
#include "Version.h"

IDI_APP_ICON ICON "Assets\MediaDuet.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MDUI_VERSION_MAJOR, MDUI_VERSION_MINOR, MDUI_VERSION_PATCH, 0
 PRODUCTVERSION MDUI_VERSION_MAJOR, MDUI_VERSION_MINOR, MDUI_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MediaDuet contributors"
            VALUE "FileDescription", "MediaDuet"
            VALUE "FileVersion", MDUI_VERSION_STRING
            VALUE "InternalName", "MediaDuetUI"
            VALUE "LegalCopyright", "Copyright (c) 2026 MediaDuet contributors. MIT License."
            VALUE "OriginalFilename", "MediaDuetUI.exe"
            VALUE "ProductName", "MediaDuet"
            VALUE "ProductVersion", MDUI_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
