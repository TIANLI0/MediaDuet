<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaDuetUI.CompactWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaDuetUI">

    <Grid x:Name="Root" Background="Transparent">
        <!-- Flowing artwork background (as on Android): dithered bitmaps rendered in code (Ambient.h). -->
        <Grid x:Name="TintLayer" IsHitTestVisible="False" />

        <!-- Idle view: artwork + song info (+ current lyric line) -->
        <Grid x:Name="PlayerGrid" Padding="12,12,14,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="68" Height="68" VerticalAlignment="Center">
                <Border x:Name="ArtPlaceholder" CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{ThemeResource ArtPlaceholderStart}" />
                            <GradientStop Offset="1" Color="{ThemeResource ArtPlaceholderEnd}" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <FontIcon FontSize="24" Glyph="&#xE8D6;">
                        <FontIcon.Foreground>
                            <SolidColorBrush Color="{ThemeResource ArtPlaceholderGlyph}" />
                        </FontIcon.Foreground>
                    </FontIcon>
                </Border>
                <Border x:Name="ArtImageBorder" CornerRadius="8" Opacity="0">
                    <Border.Background>
                        <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleLabel" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="SubLabel" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid x:Name="DeviceRow" ColumnSpacing="5" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="DeviceIcon" FontSize="10" Glyph="&#xE977;" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="DeviceLabel" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
                <Grid x:Name="LyricSlot" x:Uid="CompactLyricLine" Margin="0,2,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Host not running / connecting / nothing playing -->
        <Grid x:Name="MessageGrid" Padding="16,0,12,0" ColumnSpacing="12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="MessageIcon" FontSize="22" Glyph="&#xE8D6;" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <ProgressRing x:Name="MessageProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" />
            <TextBlock x:Name="MessageText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextBlockStyle}" />
            <Button x:Name="StartHostButton" x:Uid="StartHostButtonShort" Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed" Margin="0,0,34,0" />
        </Grid>

        <!-- Thin progress line -->
        <Grid x:Name="Progress" x:Uid="CompactProgress" VerticalAlignment="Bottom" Margin="12,0,12,3" Height="2"
              IsHitTestVisible="False" Visibility="Collapsed">
            <!-- Lightweight bar: WinUI's ProgressBar animates every value change (measured ~50 ms CPU/s). -->
            <Rectangle RadiusX="1" RadiusY="1" Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" Opacity="0.35" />
            <Rectangle RadiusX="1" RadiusY="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" RenderTransformOrigin="0,0.5">
                <Rectangle.RenderTransform>
                    <ScaleTransform x:Name="ProgressScale" ScaleX="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
        </Grid>

        <!-- Playback controls: shown only while hovered or keyboard-focused -->
        <Border x:Name="ControlsPill" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,10,0"
                CornerRadius="22" Padding="4" BorderThickness="1"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                Opacity="0" Translation="14,0,0" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="0">
                <Button x:Name="PrevButton" x:Uid="PrevButton" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" CornerRadius="18">
                    <FontIcon FontSize="13" Glyph="&#xE892;" />
                </Button>
                <Button x:Name="PlayPauseButton" x:Uid="PlayPauseButton" Style="{StaticResource IconButtonStyle}" Width="40" Height="36" CornerRadius="18">
                    <FontIcon x:Name="PlayPauseIcon" FontSize="17" Glyph="&#xE768;" />
                </Button>
                <Button x:Name="NextButton" x:Uid="NextButton" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" CornerRadius="18">
                    <FontIcon FontSize="13" Glyph="&#xE893;" />
                </Button>
                <Rectangle Width="1" Height="18" Margin="3,0" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="ExpandButton" x:Uid="ExpandButton" Style="{StaticResource IconButtonStyle}" Width="36" Height="36" CornerRadius="18">
                    <FontIcon FontSize="12" Glyph="&#xE740;" />
                </Button>
            </StackPanel>
        </Border>

        <Button x:Name="CloseButton" x:Uid="CloseButton" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,3,4,0" Width="24" Height="22" CornerRadius="4" Opacity="0" IsHitTestVisible="False">
            <FontIcon FontSize="9" Glyph="&#xE8BB;" />
        </Button>
    </Grid>
</Window>
