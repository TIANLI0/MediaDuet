<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MediaDuetUI.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaDuetUI">

    <Grid x:Name="Root">
        <NavigationView x:Name="Nav" PaneDisplayMode="Auto" ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="0"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True" OpenPaneLength="268"
                        IsTitleBarAutoPaddingEnabled="False">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavGeneral" Tag="general">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavDevicesItem" x:Uid="NavDevices" Tag="devices">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EA;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavConnectionItem" x:Uid="NavConnection" Tag="connection">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE702;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavArbitrationItem" x:Uid="NavArbitration" Tag="arbitration">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavLyrics" Tag="lyrics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F0;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavTaskbar" Tag="taskbar">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE75B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavIntegration" Tag="integration">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE93E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavCompat" Tag="compat">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE90F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="NavAudioItem" x:Uid="NavAudio" Tag="audio">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE767;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDiagnostics" Tag="diagnostics">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavAbout" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="Pages" MaxWidth="900" Padding="36,16,36,40">

                        <!-- ================= General ================= -->
                        <StackPanel x:Name="PageGeneral" Spacing="0">
                            <TextBlock x:Uid="NavGeneralTitle" Style="{StaticResource PageTitleStyle}" />

                            <TextBlock x:Uid="HdrWorkMode" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE770;" VerticalAlignment="Top" Margin="2,2,18,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Uid="SetWorkModeTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetWorkModeDesc" Style="{StaticResource CardDescriptionStyle}" />
                                        <RadioButtons x:Name="WorkModeRadios" Margin="0,8,0,0">
                                            <RadioButton x:Uid="WorkModeLinked" Tag="linked" />
                                            <RadioButton x:Uid="WorkModeStandalone" Tag="standalone" />
                                        </RadioButtons>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock x:Uid="HdrAppearance" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE774;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetLanguageTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetLanguageDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="LanguageCombo" Grid.Column="2" MinWidth="200" VerticalAlignment="Center">
                                        <ComboBoxItem x:Uid="LangAuto" Tag="auto" />
                                        <ComboBoxItem x:Uid="LangZh" Tag="zh-CN" />
                                        <ComboBoxItem x:Uid="LangEn" Tag="en-US" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE790;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetThemeTitle" Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeCombo" Grid.Column="2" MinWidth="200" VerticalAlignment="Center">
                                        <ComboBoxItem x:Uid="ThemeSystem" Tag="system" />
                                        <ComboBoxItem x:Uid="ThemeLight" Tag="light" />
                                        <ComboBoxItem x:Uid="ThemeDark" Tag="dark" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE945;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetAnimationsTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetAnimationsDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AnimationsToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xEBB5;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetLowPowerTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetLowPowerDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="LowPowerToggle" Grid.Column="2" />
                                </Grid>
                            </Border>

                            <TextBlock x:Uid="HdrWindows" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE718;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetMainOnTopTitle" Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MainOnTopToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE73F;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetCompactOnTopTitle" Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CompactOnTopToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE7C4;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetCompactSnapTitle" Style="{StaticResource CardTitleStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="CompactSnapToggle" Grid.Column="2" />
                                </Grid>
                            </Border>

                            <TextBlock x:Uid="HdrStartup" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE7E8;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetAutostartTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetAutostartDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutostartToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE7E8;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetQuitTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetQuitDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <Button x:Name="QuitHostButton" x:Uid="QuitHostButton" Grid.Column="2" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ================= Devices & pairing ================= -->
                        <StackPanel x:Name="PageDevices" Visibility="Collapsed">
                            <TextBlock x:Uid="NavDevicesTitle" Style="{StaticResource PageTitleStyle}" />
                            <!-- Phone and PC on different versions (md::version rule, from the host). -->
                            <InfoBar x:Name="DevicesVersionBar" IsOpen="False" IsClosable="False" Margin="0,12,0,0" />

                            <TextBlock x:Uid="HdrPaired" Style="{StaticResource SectionHeaderStyle}" />
                            <StackPanel x:Name="PairedList" />
                            <Border x:Name="PairedEmpty" Style="{StaticResource CardStyle}">
                                <TextBlock x:Uid="PairedEmptyText" Style="{StaticResource CardDescriptionStyle}" />
                            </Border>

                            <TextBlock x:Name="PairNewHeader" x:Uid="HdrPairNew" Style="{StaticResource SectionHeaderStyle}" />
                            <!-- QR pairing (spec §3.5): the phone scans the code, nothing to compare. The code
                                 stays dark on white in both themes so that every camera reads it. -->
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon x:Name="QrIcon" Style="{StaticResource CardIconStyle}" Glyph="&#xED14;" />
                                    <Border x:Name="QrFrame" Width="196" Height="196" Padding="14" CornerRadius="8" Background="White"
                                            Visibility="Collapsed" Margin="0,4,0,4">
                                        <Path x:Name="QrPath" Fill="Black" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock x:Uid="QrPairTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="QrPairText" Style="{StaticResource CardDescriptionStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                            <Button x:Name="QrShowButton" Style="{StaticResource AccentButtonStyle}" />
                                            <Button x:Name="QrHideButton" x:Uid="QrHideButton" Visibility="Collapsed" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE721;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="PairHowTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="PairHowDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ProgressRing x:Name="DiscoveryRing" Width="16" Height="16" IsActive="False" />
                                        <TextBlock x:Uid="Searching" Style="{StaticResource CardDescriptionStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="DiscoveredList" />
                            <Border x:Name="DiscoveredEmpty" Style="{StaticResource CardStyle}">
                                <TextBlock x:Uid="DiscoveredEmptyText" Style="{StaticResource CardDescriptionStyle}" />
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,8,0,4">
                                <StackPanel Spacing="10">
                                    <StackPanel>
                                        <TextBlock x:Uid="ManualTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="ManualDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="ManualHost" x:Uid="ManualHost" Width="220" />
                                        <NumberBox x:Name="ManualPort" Width="110" Minimum="1" Maximum="65535" Value="47321" SpinButtonPlacementMode="Hidden" />
                                        <Button x:Name="ManualPairButton" x:Uid="ManualPairButton" Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="ManualConnectButton" x:Uid="ManualConnectButton" />
                                    </StackPanel>
                                    <TextBlock x:Name="ManualError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CardDescriptionStyle}" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= Connection ================= -->
                        <StackPanel x:Name="PageConnection" Visibility="Collapsed">
                            <TextBlock x:Uid="NavConnectionTitle" Style="{StaticResource PageTitleStyle}" />

                            <TextBlock x:Uid="HdrConnStatus" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Uid="LblStatus" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="ConnStatusValue" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblPeer" Grid.Row="1" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="ConnPeerValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblTransport" Grid.Row="2" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="ConnTransportValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblLatency" Grid.Row="3" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="ConnRttValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblConnectedFor" Grid.Row="4" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="ConnSinceValue" Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblTraffic" Grid.Row="5" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="ConnTrafficValue" Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblLastError" Grid.Row="6" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="ConnErrorValue" Grid.Row="6" Grid.Column="1" Style="{StaticResource CardDescriptionStyle}" IsTextSelectionEnabled="True" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="LblBluetooth" Grid.Row="7" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="ConnBtValue" Grid.Row="7" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                </Grid>
                            </Border>

                            <TextBlock x:Uid="HdrConnMode" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock x:Uid="SetConnModeTitle" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="SetConnModeDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    <RadioButtons x:Name="ConnModeRadios" Margin="0,8,0,0">
                                        <RadioButton x:Uid="ConnModeAuto" Tag="auto" />
                                        <RadioButton x:Uid="ConnModeBt" Tag="bt_only" />
                                        <RadioButton x:Uid="ConnModeLan" Tag="lan_only" />
                                    </RadioButtons>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE895;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetSwitchBackTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetSwitchBackDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <NumberBox x:Name="SwitchBackBox" Grid.Column="2" Width="120" Minimum="0" Maximum="600" SmallChange="1"
                                               SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ================= Arbitration ================= -->
                        <StackPanel x:Name="PageArbitration" Visibility="Collapsed">
                            <TextBlock x:Uid="NavArbitrationTitle" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock x:Uid="ArbIntro" Style="{StaticResource CardDescriptionStyle}" Margin="0,0,0,4" />

                            <TextBlock x:Uid="HdrArbLive" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <TextBlock x:Name="PolicyLiveText" Style="{StaticResource ValueTextStyle}" />
                            </Border>

                            <TextBlock x:Uid="HdrArbMode" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <RadioButtons x:Name="PolicyModeRadios" x:Uid="PolicyModeRadios">
                                    <RadioButton Tag="off">
                                        <StackPanel>
                                            <TextBlock x:Uid="ModeOffTitle" />
                                            <TextBlock x:Uid="ModeOffDesc" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Tag="windows_first">
                                        <StackPanel>
                                            <TextBlock x:Uid="ModeWinTitle" />
                                            <TextBlock x:Uid="ModeWinDesc" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Tag="android_first">
                                        <StackPanel>
                                            <TextBlock x:Uid="ModeAndroidTitle" />
                                            <TextBlock x:Uid="ModeAndroidDesc" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Tag="latest">
                                        <StackPanel>
                                            <TextBlock x:Uid="ModeLatestTitle" />
                                            <TextBlock x:Uid="ModeLatestDesc" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Tag="custom">
                                        <StackPanel>
                                            <TextBlock x:Uid="ModeCustomTitle" />
                                            <TextBlock x:Uid="ModeCustomDesc" Style="{StaticResource CardDescriptionStyle}" />
                                        </StackPanel>
                                    </RadioButton>
                                </RadioButtons>
                            </Border>

                            <TextBlock x:Uid="HdrArbBehaviour" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE768;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetAutoResumeTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetAutoResumeDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoResumeToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE916;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetResumeDelayTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetResumeDelayDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <NumberBox x:Name="ResumeDelayBox" Grid.Column="2" Width="120" Minimum="0" Maximum="300" SmallChange="1"
                                               SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE121;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetActivationTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetActivationDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <NumberBox x:Name="ActivationBox" Grid.Column="2" Width="120" Minimum="100" Maximum="10000" SmallChange="100"
                                               LargeChange="500" SpinButtonPlacementMode="Compact" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE767;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetSensitivityTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetSensitivityDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Slider x:Name="SensitivitySlider" Width="180" Minimum="0.001" Maximum="0.1" StepFrequency="0.001"
                                                SmallChange="0.001" LargeChange="0.01" IsThumbToolTipEnabled="False" VerticalAlignment="Center" />
                                        <TextBlock x:Name="SensitivityValue" Width="44" VerticalAlignment="Center" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE717;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetCallsTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetCallsDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PauseForCallsToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE7F6;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetHeadsetAssistTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetHeadsetAssistDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HeadsetAssistToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="OnlyWithOutputsTitle" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="OnlyWithOutputsDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    <StackPanel x:Name="OutputsPanel" Spacing="0" />
                                    <TextBlock x:Name="OutputsGatedText" Style="{StaticResource CardDescriptionStyle}" Visibility="Collapsed"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Uid="HdrArbApps" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="BlacklistTitle" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="BlacklistDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    <StackPanel x:Name="BlacklistPanel" Spacing="4" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBox x:Name="BlacklistInput" x:Uid="ProcessInput" Width="240" />
                                        <Button x:Name="BlacklistAdd" x:Uid="AddButton" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock x:Uid="WhitelistTitle" Style="{StaticResource CardTitleStyle}" />
                                    <TextBlock x:Uid="WhitelistDesc" Style="{StaticResource CardDescriptionStyle}" />
