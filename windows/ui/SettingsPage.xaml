                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE8B9;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetArtworkOnlineTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetArtworkOnlineDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ArtworkOnlineToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <TextBlock x:Uid="HdrHandoff" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE977;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetTaskbarResumeTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetTaskbarResumeDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TaskbarResumeToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ================= Audio ================= -->
                        <StackPanel x:Name="PageAudio" Visibility="Collapsed">
                            <TextBlock x:Uid="NavAudioTitle" Style="{StaticResource PageTitleStyle}" />

                            <TextBlock x:Uid="HdrA2dp" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE7F6;" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="SetA2dpTitle" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Uid="SetA2dpDesc" Style="{StaticResource CardDescriptionStyle}" />
                                            <TextBlock x:Name="A2dpStatus" Style="{StaticResource CardDescriptionStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="A2dpToggle" Grid.Column="2" />
                                    </Grid>
                                    <InfoBar x:Name="A2dpError" Severity="Error" IsClosable="False" IsOpen="False" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Uid="HdrLanSend" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE7F5;" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Uid="SetLanSendTitle" Style="{StaticResource CardTitleStyle}" />
                                            <TextBlock x:Name="LanSendStatus" Style="{StaticResource CardDescriptionStyle}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="LanSendToggle" Grid.Column="2" />
                                    </Grid>
                                    <InfoBar x:Uid="LanSendWarning" Severity="Warning" IsClosable="False" IsOpen="True" />
                                    <InfoBar x:Name="LanSendError" Severity="Error" IsClosable="False" IsOpen="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ================= Diagnostics ================= -->
                        <StackPanel x:Name="PageDiagnostics" Visibility="Collapsed">
                            <TextBlock x:Uid="NavDiagnosticsTitle" Style="{StaticResource PageTitleStyle}" />
                            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE9D9;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetDiagTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetDiagDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="DiagnosticsToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <Border x:Name="DiagCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                                <Grid x:Name="DiagGrid">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="DiagWaiting" x:Uid="DiagWaiting" Style="{StaticResource CardDescriptionStyle}" Margin="2,8,0,0" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- ================= About ================= -->
                        <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,8">
                                <Image x:Name="AboutIcon" Width="64" Height="64" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Uid="AboutAppName" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock x:Uid="AboutTagline" Style="{StaticResource CardDescriptionStyle}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock x:Uid="LblUiVersion" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="UiVersionValue" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblHostVersion" Grid.Row="1" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="HostVersionValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblPhoneVersion" Grid.Row="2" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock x:Name="PhoneVersionValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" />
                                    <TextBlock x:Uid="LblLicense" Grid.Row="3" Style="{StaticResource ValueLabelStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Uid="AboutLicenseValue" Style="{StaticResource ValueTextStyle}" />
                                </Grid>
                            </Border>
                            <TextBlock x:Uid="HdrUpdate" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE895;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpdateTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Name="UpdateDetail" Style="{StaticResource CardDescriptionStyle}" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="UpdateProgress" Margin="0,8,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                                        <HyperlinkButton x:Name="UpdateNotesLink" x:Uid="UpdateNotesLink" Padding="0" Margin="0,4,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button x:Name="UpdateButton" Grid.Column="2" VerticalAlignment="Center" MinWidth="96" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Style="{StaticResource CardIconStyle}" Glyph="&#xE823;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="SetUpdateAutoTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="SetUpdateAutoDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="UpdateAutoToggle" Grid.Column="2" />
                                </Grid>
                            </Border>
                            <TextBlock x:Uid="HdrDeveloper" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <!-- 192 px source, circular crop; a hairline ring keeps it crisp on any background. -->
                                    <Ellipse Width="56" Height="56" VerticalAlignment="Center"
                                             Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="DeveloperAvatar" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Uid="AboutDeveloperName" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="AboutDeveloperRole" Style="{StaticResource CardDescriptionStyle}" />
                                        <HyperlinkButton x:Uid="AboutDeveloperEmail" NavigateUri="mailto:wutianli@tianli0.top"
                                                         Padding="0" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock x:Uid="HdrThirdParty" Style="{StaticResource SectionHeaderStyle}" />
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <StackPanel>
                                        <TextBlock x:Uid="ThirdWasdkTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="ThirdWasdkDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Uid="ThirdCppWinrtTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="ThirdCppWinrtDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Uid="ThirdWilTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="ThirdWilDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Uid="ThirdJsonTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="ThirdJsonDesc" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Uid="ThirdLrclibTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="AboutLrclib" Style="{StaticResource CardDescriptionStyle}" />
                                    </StackPanel>
                                    <!-- Required notice of the bundled lyrics typeface (Assets\Fonts). -->
                                    <StackPanel>
                                        <TextBlock x:Uid="ThirdHarmonyTitle" Style="{StaticResource CardTitleStyle}" />
                                        <TextBlock x:Uid="ThirdHarmonyDesc" Style="{StaticResource CardDescriptionStyle}" />
                                        <HyperlinkButton x:Name="HarmonyLicenseLink" x:Uid="ThirdHarmonyLicense" Padding="0" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Notices float over the page: opening or closing one never moves it. Each sits on a
                     FloatingNoticeStyle backing that stretches to the bar (nothing left once it closes). -->
                <Grid VerticalAlignment="Top" Margin="36,12,36,0" MaxWidth="860">
                    <Border Style="{StaticResource FloatingNoticeStyle}" />
                    <InfoBar x:Name="HostBar" Severity="Warning" IsClosable="False" IsOpen="False">
                        <InfoBar.ActionButton>
                            <Button x:Name="StartHostButton" x:Uid="StartHostButton" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Grid>
                <Grid VerticalAlignment="Bottom" Margin="36,0,36,16" MaxWidth="860">
                    <Border Style="{StaticResource FloatingNoticeStyle}" />
                    <InfoBar x:Name="ResultBar" Severity="Error" IsClosable="True" IsOpen="False" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
