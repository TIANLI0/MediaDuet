    <!-- Permissions -->
    <string name="permissions_title">Permissions &amp; background</string>
    <string name="permissions_subtitle">What MediaDuet needs and why. Anything missing only disables the related feature.</string>
    <string name="perm_required_header">Required access</string>
    <string name="perm_listener">Media session access</string>
    <string name="perm_listener_text">Granted through notification access. MediaDuet only uses it to see and control media sessions; notification contents are never read, stored or sent.</string>
    <string name="perm_listener_restricted">Installed outside an app store? On Android 13+ first open App info → ⋮ → “Allow restricted settings”.</string>
    <string name="perm_notifications">Notifications</string>
    <string name="perm_notifications_text">For the status notification, pairing requests and the optional PC media controls.</string>
    <string name="perm_bluetooth">Nearby devices (Bluetooth)</string>
    <string name="perm_bluetooth_text">Lets the PC connect over Bluetooth RFCOMM. Without it only LAN works.</string>
    <string name="perm_local_network">Local network</string>
    <string name="perm_local_network_text">Android 17+: lets the PC reach this phone over Wi‑Fi/Ethernet and advertises it on the network. Without it only Bluetooth works.</string>
    <string name="perm_background_header">Running in the background</string>
    <string name="perm_listener_bound">System binding</string>
    <string name="perm_listener_bound_text">While media session access is granted, Android keeps MediaDuet\'s listener bound, which keeps it running.</string>
    <string name="perm_battery">Battery optimisation</string>
    <string name="perm_battery_text">Doze can delay network traffic. If the PC loses the phone while the screen is off, set MediaDuet to “Unrestricted”. A companion association usually grants this automatically.</string>
    <string name="perm_bg_restricted">Background restricted</string>
    <string name="perm_bg_restricted_text">You restricted MediaDuet\'s background activity. It can\'t stay connected until this is lifted in App info → Battery.</string>
    <string name="perm_companion">Companion device</string>
    <string name="perm_companion_text">Lets Android start MediaDuet when the PC comes into Bluetooth range.</string>
